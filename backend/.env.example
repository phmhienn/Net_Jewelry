DB_URL=jdbc:mysql://127.0.0.1:3306/jewelry_store?connectionTimeZone=UTC
DB_USERNAME=jewelry
DB_PASSWORD=replace-me
JWT_SECRET=replace-with-at-least-32-random-bytes-encoded-as-base64
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
BOOTSTRAP_MANAGER_ENABLED=false
# Optional: create the first manager when tai_khoan has no staff/manager accounts.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
SHIPPING_FEE=30000
FREE_SHIPPING_THRESHOLD=1500000
MYSQL_ROOT_PASSWORD=replace-for-local-compose
# Docker Compose reads .env here and passes selected settings to containers.
# Direct mvn/java execution still needs environment variables set explicitly.
FRONTEND_PORT=5173
BACKEND_PORT=8080
MYSQL_PORT=3308
RESET_MAIL_ENABLED=false


