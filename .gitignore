# ============================================================
# Jewelry Store workspace
# Root-level ignores for local machine files and shared tooling.
# Project-specific ignores live in frontend/.gitignore and jewelry-store/.gitignore.
# ============================================================

# Operating system
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Editors / IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Local environment secrets
.env
.env.*
!.env.example

# Logs
*.log
logs/

# Local artifacts / temporary files
.artifacts/
.tmp/
tmp/
temp/
*.tmp
*.bak
*.orig

# Test / coverage artifacts shared at workspace root
coverage/
test-results/
playwright-report/

# Do not ignore source/runtime setup files such as database.sql, demo-data.sql,
# compose.yaml, Dockerfile, package-lock.json, or .env.example.
